# Copiar a .env.local y completar.  Los .env NUNCA se commitean.

# --- Backend ---
# En Docker el host es el nombre del servicio: core-api
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL_INTERNA=http://core-api:8080

# --- jobout-interview (WebSocket de la entrevista) ---
NEXT_PUBLIC_INTERVIEW_WS_URL=ws://localhost:8000/interview

# Autenticación: en el MVP la maneja core-api con JWT propio (sin Clerk).
# Los tokens van en cookies HttpOnly; no hay variables de sesión que exponer al navegador.

# Todo lo que lleve NEXT_PUBLIC_ viaja al navegador y es visible para cualquiera.
# Un secreto NUNCA lleva ese prefijo.
